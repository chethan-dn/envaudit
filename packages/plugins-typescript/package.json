{
  "name": "envanalyser-plugins-typescript",
  "version": "0.2.0",
  "description": "TypeScript and JavaScript scanner plugin for EnvAnalyser",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chethan-dnc/envanalyser.git",
    "directory": "packages/plugins-typescript"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "envanalyser-contracts": "workspace:*",
    "envanalyser-plugins-nestjs": "workspace:*",
    "fast-glob": "^3.3.3",
    "ts-morph": "^25.0.1"
  }
}
