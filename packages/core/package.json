{
  "name": "envaudit-core",
  "version": "0.2.0",
  "description": "Core orchestration and analysis engine for EnvAudit",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chethan-dnc/envaudit.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "envaudit-contracts": "workspace:*",
    "fast-glob": "^3.3.3"
  }
}
