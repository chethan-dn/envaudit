{
  "name": "@envdoctor/plugins",
  "version": "0.1.2",
  "description": "Builtin plugin registry for EnvDoctor",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builtins": {
      "types": "./dist/builtins/index.d.ts",
      "import": "./dist/builtins/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chethan-dnc/envdoctor.git",
    "directory": "packages/plugins"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@envdoctor/contracts": "workspace:*",
    "@envdoctor/plugins-typescript": "workspace:*"
  },
  "devDependencies": {
    "@envdoctor/core": "workspace:*"
  }
}
