{
  "name": "@envdoctor/cli",
  "version": "0.0.0",
  "description": "Environment Intelligence CLI",
  "license": "MIT",
  "private": false,
  "type": "module",
  "files": ["dist", "package.json"],
  "bin": {
    "envdoctor": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chethan-dnc/envdoctor.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@envdoctor/core": "workspace:*",
    "@envdoctor/plugins": "workspace:*",
    "commander": "^14.0.0"
  }
}
