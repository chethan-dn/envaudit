{
  "name": "envaudit",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:release": "pnpm --filter envaudit... run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:pack": "pnpm build:release && node scripts/validate-pack.mjs",
    "release:check": "pnpm build && pnpm test && pnpm validate:pack",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:release && changeset publish"
  },
  "author": [
    "chethan-dnc <chethan.dnc@arithaconsulting.com>",
    "chethan-dn <chethan.dnc@gmail.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chethan-dnc/envaudit.git",
    "directory": "packages/plugins"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.1.4"
  }
}
